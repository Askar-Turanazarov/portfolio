# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Every variable is optional:
# an unset contact is simply not shown on the site.

# Canonical origin. Leave empty on Vercel until you attach your own domain:
# the build then uses VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# Contacts shown in the Contact section and the footer.
NEXT_PUBLIC_CONTACT_EMAIL=
# "@name", "name" or a full https://t.me/name URL.
NEXT_PUBLIC_CONTACT_TELEGRAM=
NEXT_PUBLIC_CONTACT_LINKEDIN=
# Public URL of a CV (PDF), e.g. a file in /public or a shared link.
NEXT_PUBLIC_CV_URL=
